POSTGRES_DB=network_health
POSTGRES_USER=network_health
POSTGRES_PASSWORD=change-me
DB_PORT=5434
BACKEND_PORT=8001
FRONTEND_PORT=3000
FRONTEND_BIND_ADDRESS=127.0.0.1
# Keep 127.0.0.1 locally; use the Ubuntu VM IP for access from Windows.
BACKEND_BIND_ADDRESS=127.0.0.1
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_KEY=replace-with-generated-fernet-key
LAB_CIDRS=192.168.141.0/24,192.168.91.0/24
CORS_ORIGINS=http://localhost:3000
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MINUTES=15
MAX_CONCURRENT_CHECKS=3
AUTH_ENABLED=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=480
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
